{
  "name": "@bloodhound-rs/playground",
  "version": "0.0.0",
  "description": "Embeddable Bloodhound Playground, manifest viewer and resource selector for React",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/styles.css', 'dist/styles.css')\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@bloodhound-rs/manifest": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/react": "^18.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justinidlerz/bloodhound.git",
    "directory": "packages/playground"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  }
}
