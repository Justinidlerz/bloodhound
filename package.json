{
  "name": "@bloodhound-rs/core",
  "version": "0.3.1",
  "description": "Rust static scanner that finds global-environment pollution in JavaScript and HTML",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.20.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build:ts": "pnpm build:manifest && tsc -p tsconfig.json",
    "build:plugin": "pnpm --filter @bloodhound-rs/rollup-plugin build",
    "build:js": "pnpm build:ts && pnpm build:plugin && pnpm build:playground-package",
    "build": "node scripts/clean-dist.mjs && pnpm build:native && pnpm build:js && node scripts/assemble-wasi.mjs --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit --strict --skipLibCheck --module NodeNext --target ES2023 tests/types.test.ts && pnpm --filter @bloodhound-rs/rollup-plugin typecheck && pnpm typecheck:playground && pnpm --filter @bloodhound-rs/manifest typecheck && pnpm --filter @bloodhound-rs/playground typecheck",
    "prepack": "pnpm build",
    "example": "node examples/scan.mjs",
    "example:html": "node examples/scan-html.mjs",
    "example:rollup": "rollup -c examples/rollup/rollup.config.mjs",
    "example:rolldown": "rolldown -c examples/rollup/rolldown.config.mjs",
    "playground": "node playground/scripts/dev.mjs",
    "build:playground": "node playground/scripts/build.mjs",
    "typecheck:playground": "tsc --noEmit -p playground/tsconfig.json",
    "format": "prettier --write src scripts tests examples packages playground README.md docs .github .changeset package.json tsconfig.json npm pnpm-workspace.yaml",
    "format:check": "prettier --check src scripts tests examples packages playground README.md docs .github .changeset package.json tsconfig.json npm pnpm-workspace.yaml",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:packages": "changeset version && node scripts/sync-native-version.mjs && node scripts/sync-platform-packages.mjs",
    "platforms:sync": "node scripts/sync-platform-packages.mjs",
    "pack:release": "node scripts/pack-ci.mjs",
    "test": "pnpm test:rust && pnpm test:scripts && pnpm build && pnpm typecheck && pnpm test:sdk && pnpm test:plugin",
    "test:rust": "cargo test --locked --lib",
    "test:scripts": "node --test tests/scripts.test.mjs tests/release.test.mjs",
    "test:sdk": "node --test tests/sdk.test.mjs",
    "test:plugin": "pnpm --filter @bloodhound-rs/rollup-plugin test",
    "build:manifest": "pnpm --filter @bloodhound-rs/manifest build",
    "build:playground-package": "pnpm --filter @bloodhound-rs/playground... build",
    "build:wasi": "node scripts/build-native.mjs --wasi && pnpm build:js && node scripts/assemble-wasi.mjs",
    "test:wasi": "node --import ./scripts/load-wasi.mjs --test tests/sdk.test.mjs packages/rollup-plugin/tests/plugin.test.mjs"
  },
  "devDependencies": {
    "@bloodhound-rs/rollup-plugin": "workspace:*",
    "@changesets/cli": "3.0.3",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@napi-rs/cli": "3.10.8",
    "@types/node": "^22.19.0",
    "prettier": "3.6.2",
    "rolldown": "1.2.14",
    "rollup": "^4.64.12",
    "typescript": "^5.9.3",
    "@bloodhound-rs/playground": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "emnapi": "2.0.0-beta.3",
    "@emnapi/core": "2.0.0-beta.3",
    "@emnapi/runtime": "2.0.0-beta.3"
  },
  "napi": {
    "binaryName": "bloodhound",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "wasm32-wasip1-threads"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justinidlerz/bloodhound.git"
  },
  "optionalDependencies": {
    "@bloodhound-rs/core-darwin-arm64": "workspace:*",
    "@bloodhound-rs/core-darwin-x64": "workspace:*",
    "@bloodhound-rs/core-linux-arm64-gnu": "workspace:*",
    "@bloodhound-rs/core-linux-x64-gnu": "workspace:*",
    "@bloodhound-rs/core-win32-x64-msvc": "workspace:*",
    "@bloodhound-rs/core-wasm32-wasi": "workspace:*"
  },
  "dependencies": {
    "@bloodhound-rs/manifest": "workspace:*"
  }
}
